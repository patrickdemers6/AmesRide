{
  "cli": {
    "version": ">= 2.7.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "node": "24.14.0"
    },
    "beta": {
      "distribution": "internal",
      "channel": "beta",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_HOST": "https://amesride.demerstech.com",
        "EAS_USE_PRECOMPILED_MODULES": "0"
      },
      "node": "24.14.0"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_HOST": "https://amesride.demerstech.com",
        "EAS_USE_PRECOMPILED_MODULES": "0"
      },
      "node": "24.14.0"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "1666007719"
      }
    }
  }
}
